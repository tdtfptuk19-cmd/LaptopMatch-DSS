            "default": [
              "cpu",
              "ram",
              "ssd",
              "w"
            ]
          },
          "matrix": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Matrix",
            "description": "Ma trận so sánh cặp nxn theo thang Saaty 1-9"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "Phương pháp tính: 'eigen' (Principal Eigenvector) hoặc 'geometric'",
            "default": "eigen"
          }
        },
        "type": "object",
        "required": [
          "matrix"
        ],
        "title": "AHPRequest"
      },
      "AHPResponse": {
        "properties": {
          "is_consistent": {
            "type": "boolean",
            "title": "Is Consistent"
          },
