      "post": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Ghi nhận đánh giá phản hồi từ người dùng",
        "description": "Ghi nhận đánh giá tính hữu ích (Có/Không), số sao và góp ý để cải tiến DSS.",
        "operationId": "record_feedback_api_feedback_post",
