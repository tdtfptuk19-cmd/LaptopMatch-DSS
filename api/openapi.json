          },
          "consistency_index": {
            "type": "number",
            "title": "Consistency Index"
          },
          "lambda_max": {
            "type": "number",
            "title": "Lambda Max"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Weights"
          },
          "warning": {
