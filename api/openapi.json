              {
                "type": "null"
              }
            ],
            "title": "Warning"
          },
          "inconsistency_hints": {
            "items": {
              "$ref": "#/components/schemas/InconsistencyHint"
            },
            "type": "array",
            "title": "Inconsistency Hints",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "is_consistent",
          "consistency_ratio",
          "consistency_index",
          "lambda_max",
          "weights"
        ],
