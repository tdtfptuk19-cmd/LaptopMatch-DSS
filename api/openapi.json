{
  "openapi": "3.1.0",
  "info": {
    "title": "LaptopMatch Decision Support System API",
    "description": "\n    Hệ thống Hỗ trợ Ra Quyết định Mua sắm Laptop (DSS301 - Nhóm 1).\n    Xây dựng theo kiến trúc 4 hệ thống con (Turban – Sharda – Delen):\n    - Data Management Subsystem (ETL, Multi-seller Scrapers, Data Quality Audit)\n    - Model Management Subsystem (Hedonic OLS Robust HC3, AHP Saaty, Multi-criteria Scoring, What-If Simulation)\n    - User Interface / Dialog Subsystem (RESTful API, Telemetry, Feedback)\n    - Knowledge-based Subsystem (Rule-based Decision Matrix & AI Explanation)\n    ",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Kiểm tra trạng thái hệ thống",
        "description": "Kiểm tra kết nối CSDL và các thành phần cốt lõi.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/personas": {
      "get": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Lấy danh sách các Persona mẫu",
        "description": "Trả về danh sách các Persona có sẵn trong hệ thống (Q1, U1, U2, U4, U5).",
        "operationId": "list_personas_api_personas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/recommend": {
      "post": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Gợi ý danh sách laptop tối ưu theo DSS_Score",
        "description": "Tính điểm DSS_Score = Eligibility x [alpha*Utility + (1-alpha)*Deal].\nCung cấp thông tin chi tiết từng tiêu chí S_k, Shop_Trust và cảnh báo đắt >= 10%.",
        "operationId": "recommend_laptops_api_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ahp/calculate": {
      "post": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Tính trọng số ưu tiên bằng ma trận so sánh cặp AHP",
        "description": "Tiếp nhận ma trận so sánh cặp theo thang Saaty 1-9.\nTính toán vector trọng số w_k, chỉ số CI, CR.\nNếu CR >= 0.10 sẽ trả về cảnh báo và gợi ý cặp tiêu chí cần điều chỉnh.",
        "operationId": "calculate_ahp_api_ahp_calculate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AHPRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AHPResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/whatif": {
      "post": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Mô phỏng phân tích kịch bản What-If",
        "description": "Chạy các kịch bản What-if:\n- WS1: Thắt chặt ngân sách (30tr -> 20tr -> 18tr)\n- WS2: Gaming / Đồ họa\n- WS3: SAZO giảm giá Zenbook AI 7 350\n- WS4: Ràng buộc di động cứng\n- WS5: Hệ sinh thái Apple\n- Custom: Tùy biến mọi tham số",
        "operationId": "run_whatif_scenario_api_whatif_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatIfResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/models/hedonic": {
      "get": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Lấy thông số mô hình định giá Hedonic OLS Robust HC3",
        "description": "Trả về 6 hệ số beta, intercept, R2, MAPE (5-fold CV), Breusch-Pagan p-value\nvà metadata phiên bản đang hoạt động của mô hình Hedonic.",
        "operationId": "get_hedonic_model_metadata_api_models_hedonic_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HedonicModelResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "tags": [
          "LaptopMatch DSS"
        ],
        "summary": "Ghi nhận sự kiện người dùng (đo lường RAR)",
        "description": "Ghi nhận hành vi tương tác của người dùng:\n- view_seller: Click sang website nhà bán\n- save_laptop: Lưu máy vào danh sách ưa thích\n- copy_config: Sao chép cấu hình\n- pin_compare: Ghim để so sánh\nPhục vụ trực tiếp cho Khuyến nghị R6: Đo lường Recommendation Acceptance Rate (RAR).",
        "operationId": "record_telemetry_api_telemetry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryEventRequest"
              }
            }
          },
          "required": true
