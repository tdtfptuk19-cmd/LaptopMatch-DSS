# =================================================================
# LaptopMatch DSS - Environment Variables Configuration Template
# Sao chép tệp này thành .env trên máy của bạn và điền các giá trị.
# TUYỆT ĐỐI KHÔNG commit tệp .env chứa mật khẩu/API key lên GitHub.
# =================================================================

# Môi trường chạy (development / production)
ENVIRONMENT=development

# Cấu hình Cơ sở dữ liệu
# Dev: SQLite local
DATABASE_URL=sqlite:///laptopmatch.db
# Prod: PostgreSQL (Supabase / Neon / Render Postgres)
# DATABASE_URL=postgresql://user:password@ep-host.region.pooler.supabase.com:5432/postgres

# Cấu hình Web Server FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# Scraper Settings (Tuân thủ Nguyên tắc 4: Rate-limit >= 2s, User-Agent rõ ràng)
SCRAPER_RATE_LIMIT_SECONDS=2.0
SCRAPER_USER_AGENT=LaptopMatch-DSS-ResearchBot/1.0 (+http://laptopmatch.local/bot)

# Knowledge-based Subsystem (Google Gemini API cho LLM Advisor)
GEMINI_API_KEY=your_gemini_api_key_here
